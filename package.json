{
  "name": "modern-charts",
  "version": "0.1.0-alpha.0",
  "description": "Composable, framework-agnostic Web Component charting library inspired by Nivo and Apache ECharts, powered solely by D3 and @chenglou/pretext.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "homepage": "https://jingcai86.github.io/modern-charts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingcai86/modern-charts.git"
  },
  "bugs": {
    "url": "https://github.com/jingcai86/modern-charts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.examples.config.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:examples": "vite build --config vite.examples.config.ts",
    "preview:examples": "vite preview --config vite.examples.config.ts",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "charts",
    "web-components",
    "custom-elements",
    "d3",
    "pretext",
    "nivo",
    "echarts",
    "data-visualization",
    "svg",
    "ai-streaming"
  ],
  "author": "Jing Cai",
  "license": "MIT",
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/d3": "^7.4.3",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
