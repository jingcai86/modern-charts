{
  "name": "modern-charts",
  "version": "0.1.0-alpha.2",
  "description": "Composable, framework-agnostic Web Component charting library inspired by Nivo and Apache ECharts, powered solely by D3 and @chenglou/pretext.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/core.js"
    },
    "./bar": {
      "types": "./dist/entries/bar.d.ts",
      "import": "./dist/bar.js"
    },
    "./line": {
      "types": "./dist/entries/line.d.ts",
      "import": "./dist/line.js"
    },
    "./pie": {
      "types": "./dist/entries/pie.d.ts",
      "import": "./dist/pie.js"
    },
    "./heatmap": {
      "types": "./dist/entries/heatmap.d.ts",
      "import": "./dist/heatmap.js"
    },
    "./radar": {
      "types": "./dist/entries/radar.d.ts",
      "import": "./dist/radar.js"
    },
    "./sunburst": {
      "types": "./dist/entries/sunburst.d.ts",
      "import": "./dist/sunburst.js"
    },
    "./sankey": {
      "types": "./dist/entries/sankey.d.ts",
      "import": "./dist/sankey.js"
    },
    "./scatter": {
      "types": "./dist/entries/scatter.d.ts",
      "import": "./dist/scatter.js"
    },
    "./treemap": {
      "types": "./dist/entries/treemap.d.ts",
      "import": "./dist/treemap.js"
    },
    "./gauge": {
      "types": "./dist/entries/gauge.d.ts",
      "import": "./dist/gauge.js"
    },
    "./context/schema": "./dist/context/charts.schema.json",
    "./context/*": "./dist/context/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/core.js",
    "./dist/bar.js",
    "./dist/line.js",
    "./dist/pie.js",
    "./dist/heatmap.js",
    "./dist/radar.js",
    "./dist/sunburst.js",
    "./dist/sankey.js",
    "./dist/scatter.js",
    "./dist/treemap.js",
    "./dist/gauge.js"
  ],
  "homepage": "https://jingcai86.github.io/modern-charts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingcai86/modern-charts.git"
  },
  "bugs": {
    "url": "https://github.com/jingcai86/modern-charts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.apps.config.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:apps": "vite build --config vite.apps.config.ts",
    "preview:apps": "vite preview --config vite.apps.config.ts",
    "build:examples": "npm run build:apps",
    "preview:examples": "npm run preview:apps",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "docker:up": "docker compose up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "charts",
    "web-components",
    "custom-elements",
    "d3",
    "pretext",
    "nivo",
    "echarts",
    "data-visualization",
    "svg",
    "ai-streaming"
  ],
  "author": "Jing Cai",
  "license": "MIT",
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/d3": "^7.4.3",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
